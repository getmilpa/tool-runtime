#!/usr/bin/env bash
# pre-push — what this push would cost the family (familia · greenhouse decisions/0218).
#
# Lives in the package's own `.githooks/` so it travels WITH the repository — versioned, reviewable,
# and the same for everyone. Git still has to be told to look there, once per clone:
#
#   git config core.hooksPath .githooks
#
# It fails ONLY when a sibling NAMES a symbol this push removes. Removing what nobody names is free,
# and a gate that cries wolf gets switched off in a week.
#
# git hands a pre-push hook the remote NAME in $1 (not a ref) and the refs being pushed on stdin as
#   <local ref> <local sha> <remote ref> <remote sha>
# so the baseline is the REMOTE SHA — what the remote already has. All zeros means the branch is new
# over there and there is nothing to compare against; the hook stands aside rather than inventing one.
#
# Without the familia app on disk it says so and exits 0: NOT BEING ABLE TO MEASURE IS NOT FAILING,
# which is the same posture every deterministic gate in this house takes about a missing workshop.
#
# (c) Rodrigo Vicente - TeamX Agency — https://teamx.agency · Apache-2.0
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# Where the app is: told, then the sibling checkout, then the one next to the family of repos.
FAMILIA="${FAMILIA_APP:-}"
[ -z "$FAMILIA" ] && [ -x "$ROOT/../familia/bin/family-gate" ] && FAMILIA="$ROOT/../familia"
[ -z "$FAMILIA" ] && [ -x "$ROOT/../../familia/bin/family-gate" ] && FAMILIA="$ROOT/../../familia"

if [ -z "$FAMILIA" ] || [ ! -x "$FAMILIA/bin/family-gate" ]; then
  echo "pre-push: familia is not on disk, so what this push costs the family was not measured." >&2
  exit 0
fi

PACKAGE="$(php -r 'echo json_decode(file_get_contents("composer.json"))->name ?? "";' 2>/dev/null)"
[ -z "$PACKAGE" ] && exit 0

ZERO="0000000000000000000000000000000000000000"
STATUS=0

while read -r _local_ref _local_sha _remote_ref remote_sha; do
  [ -z "${remote_sha:-}" ] && continue
  [ "$remote_sha" = "$ZERO" ] && continue

  php "$FAMILIA/bin/family-gate" "$PACKAGE" "$remote_sha" || STATUS=1
done

exit "$STATUS"
